# ==============================================================================
# VIETNAM TAX & LEGAL MCP — CONFIGURATION TEMPLATE
# ==============================================================================
#
# CRITICAL SECURITY NOTE FOR PRODUCTION DEPLOYMENTS:
# 1. NEVER deploy with default 'minioadmin' or 'postgres:postgres' credentials!
# 2. In production, inject cryptographically random secrets via Secret Manager / Vault.
# 3. Use TLS/SSL connections for DATABASE_URL (sslmode=require) and OBJECT_STORAGE_ENDPOINT.
# 4. Set ALLOW_LOCAL_FETCH=false and enforce private VPC subnet networking.
# 5. Rotate credentials every 90 days.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Mode
# ------------------------------------------------------------------------------
# Set to 'production' on production servers
NODE_ENV=development
PORT=3000

# Transport: 'stdio' for AI Agents (Claude Desktop, Cursor), 'http' for remote MCP
MCP_TRANSPORT=stdio
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Local Development default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vietnam_tax_legal
# Production example:
# DATABASE_URL=postgresql://tax_mcp_app:STRONG_RANDOM_PASSWORD@pg-cluster.internal:5432/vietnam_tax_legal?sslmode=require

# ------------------------------------------------------------------------------
# 3. Object Storage (S3 / MinIO / Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Local MinIO Sandbox defaults (DO NOT USE IN PRODUCTION):
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=vietnam-tax-legal
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Production S3 example:
# OBJECT_STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# OBJECT_STORAGE_BUCKET=vietnam-tax-legal-prod
# OBJECT_STORAGE_ACCESS_KEY=AKIA_PRODUCTION_KEY
# OBJECT_STORAGE_SECRET_KEY=PRODUCTION_SECRET_FROM_VAULT
# OBJECT_STORAGE_REGION=ap-southeast-1
# OBJECT_STORAGE_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 4. Ingestion Pipeline & Checkpoints
# ------------------------------------------------------------------------------
INGESTION_INTERVAL_MINUTES=15
DAILY_BACKFILL_ENABLED=true
WEEKLY_RECONCILIATION_ENABLED=true

CONGBAO_RSS_URL=https://congbao.chinhphu.vn/home.rss
HTTP_TIMEOUT_MS=15000
MAX_SOURCE_BYTES=52428800

# Security: Set to 'false' in production to block localhost/private IP resolution
ALLOW_LOCAL_FETCH=false

# ------------------------------------------------------------------------------
# 5. Search Features
# ------------------------------------------------------------------------------
ENABLE_VECTOR_SEARCH=false
